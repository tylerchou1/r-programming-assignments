
# Assignment 9: R Graphics Systems

# Load dataset
data("iris", package = "datasets")
head(iris)

# Load packages
library(lattice)
library(ggplot2)


# 1. Base R Graphics

# Plot 1: Scatter plot
plot(iris$Sepal.Length, iris$Petal.Length,
     main = "Base R: Sepal Length vs. Petal Length",
     xlab = "Sepal Length",
     ylab = "Petal Length",
     col = iris$Species,
     pch = 19)

legend("topleft",
       legend = levels(iris$Species),
       col = 1:3,
       pch = 19)

# Plot 2: Histogram
hist(iris$Petal.Length,
     main = "Base R: Distribution of Petal Length",
     xlab = "Petal Length",
     col = "lightblue",
     border = "black")


# 2. Lattice Graphics

# Plot 3: Conditional scatter plot
xyplot(Petal.Length ~ Sepal.Length | Species,
       data = iris,
       main = "Lattice: Petal Length vs. Sepal Length by Species",
       xlab = "Sepal Length",
       ylab = "Petal Length",
       pch = 19)


# 3. ggplot2

# Plot 4: Scatter plot with regression lines
ggplot(iris, aes(x = Sepal.Length,
                 y = Petal.Length,
                 color = Species)) +
  geom_point() +
  geom_smooth(method = "lm", se = FALSE) +
  labs(title = "ggplot2: Sepal Length vs. Petal Length",
       x = "Sepal Length",
       y = "Petal Length",
       color = "Species") +
  theme_minimal()

